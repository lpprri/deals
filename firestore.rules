// Aturan keamanan Firestore — Partnership LPP RRI.
// Model 1 ROLE (keputusan pengguna 14 Nov 2026 21:29 WIB): hanya ada
// Operator (Staf Layanan & Pengembangan Usaha). 6 peran dummy Q-01 TIDAK
// BERLAKU; peran Admin Nasional TIDAK DIPAKAI tahap ini.
// KOREKSI 2026-11-15: peran klien dihapus — tidak ada akses klien
// terautentikasi; akses publik (Lacak + pengajuan publik) diatur di blok
// publik tersendiri.
// Semua akses wajib terautentikasi, KECUALI dua jalur publik di blok
// publik tersendiri di bawah (Lacak + pengajuan publik) — keduanya
// dibatasi ketat: create publik tervalidasi dan append-only, get publik
// hanya per-dokumen (list dilarang). Data Keuangan (penerimaanAcuan)
// hanya dibaca, tidak pernah ditulis dari aplikasi.
// CARA AKTIFKAN: tempel seluruh isi file ini di Firebase console →
// Firestore Database → Rules → Publish. File ini saja BELUM mengaktifkan
// aturan apa pun di proyek pengguna.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pembantu ----------

    // Sudah login (akun Auth apa pun yang dibuat admin di console).
    function sudahLogin() {
      return request.auth != null;
    }

    // Dokumen profil pemanggil di koleksi users.
    function profilPemanggil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Pemanggil adalah Operator (satu-satunya peran tahap ini).
    function adalahOperator() {
      return sudahLogin() && profilPemanggil().peran == 'operator';
    }

    // Kode satker pemanggil, dari dokumen users/{uid}-nya.
    function satkerPemanggil() {
      return profilPemanggil().satker.kode;
    }

    // Data (lama atau baru) milik satker pemanggil.
    function satkerMilikPemanggil(data) {
      return data.satker.kode == satkerPemanggil();
    }

    // ---------- Koleksi data bersatker (14 koleksi di blok ini) ----------
    // Baca/tulis hanya Operator dari satker yang sama. Saat membuat data
    // baru, satker dicek dari data yang dikirim; saat mengubah, dicek dari
    // data lama DAN data baru (tidak boleh pindah satker). Tiket &
    // umpanBalik (Fase C) memakai aturan yang sama di blok tersendiri di
    // bawah, jadi total koleksi bersatker menjadi 16.
    match /{koleksi}/{id} {
      allow read: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task'
        ]
        && adalahOperator()
        && satkerMilikPemanggil(resource.data);
      allow create: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task'
        ]
        && adalahOperator()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task'
        ]
        && adalahOperator()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task'
        ]
        && adalahOperator()
        && satkerMilikPemanggil(resource.data);
    }

    // ---------- Data acuan Keuangan: READ-ONLY ----------
    // Setelah migrasi, tidak ada satu pun peran aplikasi yang boleh
    // create/update/delete — data ini milik Keuangan; aplikasi hanya
    // menampilkan dan merekonsiliasi. Satu-satunya pengecualian adalah
    // migrasi satu kali (src/lib/migrasi.ts): sebelum dokumen
    // `meta/migrasi` ada, Operator boleh create (menulis 62 baris acuan
    // awal). Begitu penanda migrasi ada, create ikut tertutup.
    match /penerimaanAcuan/{id} {
      allow read: if adalahOperator()
        && satkerMilikPemanggil(resource.data);
      allow create: if adalahOperator()
        && !exists(/databases/$(database)/documents/meta/migrasi)
        && satkerMilikPemanggil(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- Dokumen: tanpa field satker ----------
    // Koleksi dokumen tidak menyimpan field satker (tautan ke kontrak),
    // jadi hanya dicek peran Operator.
    match /dokumen/{id} {
      allow read, create, update, delete: if adalahOperator();
    }

    // ---------- Help-Desk & Feedback: bersatker (Fase C) ----------
    // Tiket konsultasi dan umpan balik survei milik satker pemanggil —
    // aturan sama seperti koleksi bersatker lain (dibuat di blok umum di
    // atas, tapi ditulis terpisah di sini agar mudah dibaca per modul).
    // Tiket ditujukan ke Direktorat Layanan & Pengembangan Usaha (Q-12);
    // PIC per kategori belum ditentukan, jadi tidak ada aturan per PIC.
    match /tiket/{id} {
      allow read: if adalahOperator() && satkerMilikPemanggil(resource.data);
      allow create: if adalahOperator()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if adalahOperator()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if adalahOperator() && satkerMilikPemanggil(resource.data);
    }
    match /umpanBalik/{id} {
      allow read: if adalahOperator() && satkerMilikPemanggil(resource.data);
      allow create: if adalahOperator()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if adalahOperator()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if adalahOperator() && satkerMilikPemanggil(resource.data);
    }

    // ---------- Knowledge Base: nasional, tanpa field satker (Fase C) ----------
    // Artikel Regulasi & SOP dibaca Operator mana pun (nasional, seperti
    // dokumen) dan ditulis Operator. Tidak ada filter satker karena entitas
    // artikelKB memang tidak menyimpan field satker.
    match /artikelKB/{id} {
      allow read, create, update, delete: if adalahOperator();
    }

    // ---------- Audit: hanya tambah (append-only) ----------
    // Entri audit tidak boleh diubah atau dihapus setelah ditulis.
    match /audit/{id} {
      allow read, create: if adalahOperator();
      allow update, delete: if false;
    }

    // ---------- Penanda migrasi: hanya boleh dibuat sekali ----------
    // Migrasi satu kali (src/lib/migrasi.ts) membuat dokumen ini; bila
    // sudah ada, create ditolak.
    match /meta/migrasi {
      allow read: if adalahOperator();
      allow create: if adalahOperator()
        && !exists(/databases/$(database)/documents/meta/migrasi);
      allow update, delete: if false;
    }

    // ---------- Profil pengguna (koleksi users) ----------
    // Pengguna hanya boleh membaca dokumennya sendiri. Saat login pertama,
    // pengguna membuat dokumennya sendiri sebagai Operator (akun Auth
    // hanya dibuat admin lewat console, jadi tidak ada pendaftaran liar).
    // Peran dan satker TIDAK boleh diubah setelah dibuat — perubahan peran
    // dilakukan admin langsung di console.
    match /users/{uid} {
      allow get: if sudahLogin() && request.auth.uid == uid;
      allow create: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.peran == 'operator'
        && request.resource.data.satker.kode is string;
      allow update: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.peran == resource.data.peran
        && request.resource.data.satker == resource.data.satker;
      allow delete: if false;
    }

    // ---------- Profil pengguna (koleksi userProfiles, dipakai migrasi) ----------
    // Pengguna hanya boleh membaca dokumennya sendiri (dicocokkan lewat
    // email akun Auth). Hanya Operator boleh menulis — dipakai untuk
    // bootstrap profil saat migrasi satu kali.
    match /userProfiles/{email} {
      allow get: if sudahLogin() && request.auth.token.email == email;
      allow create, update, delete: if adalahOperator();
    }

    // ---------- Pengajuan publik — antrean approval (Operator) ----------
    // KOREKSI 2026-11-15: peran klien dihapus. Submission publik
    // (pengajuanKlien) tetap dibaca/diproses Operator dari satkernya.
    // Aturan Firestore bersifat OR antar blok match yang sama.

    // Submission publik (form Ajukan Permohonan, tanpa login).
    match /pengajuanKlien/{id} {
      // Operator: baca penuh satkernya (dipakai muatDariFirestore).
      allow read: if adalahOperator()
        && satkerMilikPemanggil(resource.data);
      // Operator boleh membuat (tidak dipakai aplikasi saat ini).
      allow create: if adalahOperator()
        && satkerMilikPemanggil(request.resource.data);
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form Ajukan Permohonan (src/modules/Ajukan.tsx lewat
      // kirimPengajuanPublik di firestoreStore.ts). TIDAK ada read /
      // update / delete publik — antrean hanya dibaca dan diproses
      // Operator. Validasi: field wajib terisi, jenis dari daftar yang
      // dikenal, status SELALU 'Menunggu', klienId SELALU '' (calon klien
      // belum tercatat; diisi Operator saat approval).
      allow create: if request.auth == null
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.klienId == ''
        && request.resource.data.jenis in [
          'Pengajuan Kerja Sama', 'Media Order', 'Permohonan Sewa'
        ]
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() > 0
        && request.resource.data.namaPic is string
        && request.resource.data.namaPic.size() > 0
        && request.resource.data.namaInstitusi is string
        && request.resource.data.namaInstitusi.size() > 0
        && request.resource.data.dibuatOleh is string
        && request.resource.data.dibuatOleh.size() > 0
        && request.resource.data.tanggalBuat is string
        && request.resource.data.tanggalBuat.size() > 0
        && request.resource.data.satker.kode is string
        && (!('nilaiPerkiraan' in request.resource.data)
          || request.resource.data.nilaiPerkiraan is number)
        && (!('telepon' in request.resource.data)
          || request.resource.data.telepon is string);
      // Hanya Operator yang mengubah (approval): satker tidak boleh pindah.
      allow update: if adalahOperator()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if false;
    }

    // ---------- Akses publik Lacak — get-by-ID saja, TANPA list ----------
    // KOREKSI 2026-11-15: klien mengakses dokumen kerja samanya dengan
    // memasukkan nomor PKS / nomor tagihan (keputusan 11:22 WIB).
    // Desain anti-enumerasi: publik HANYA boleh `get` satu dokumen
    // kontrak bila tahu ID-nya. ID dokumen kontrak = nomorPks yang
    // di-encode (firestoreStore.ts: kodeIdDokumen memakai
    // encodeURIComponent untuk ID yang mengandung '/'). `list`
    // DILARANG — tidak ada yang bisa mendaftar atau menghitung semua
    // kontrak dari jalur ini.
    // Keterbatasan yang disadari: get-by-ID hanya mendukung lookup lewat
    // nomor PKS. Lookup lewat nomor TAGIHAN + daftar terkait (tagihan,
    // dokumen, pembayaran per kontrak) TIDAK bisa diambil aman hanya
    // dengan rules — query/list tidak bisa dibatasi ke satu kontrak oleh
    // rules. Untuk itu ada Cloud Function `lacakKerjaSama`
    // (functions/index.js) yang memeriksa kode server-side (Admin SDK,
    // melewati rules) dan hanya mengembalikan data kontrak itu.
    // Sampai function itu di-deploy dan App.tsx memanggilnya, Lacak
    // mode Firestore memakai data seed (mode contoh) — lihat komentar di
    // src/modules/Lacak.tsx. Lacak mode contoh bekerja penuh dari seed.
    // PERINGATAN: blok ini BELUM TERVALIDASI COMPILER — ditulis dari
    // dokumentasi aturan Firestore dan belum diuji di Rules Playground /
    // emulator. Tempel di console, periksa tidak ada error, baru Publish.
    match /kontrak/{id} {
      allow get: if request.auth == null;
      allow list: if false;
    }
  }
}
