// Aturan keamanan Firestore — Partnership LPP RRI.
// Model TIGA PERAN (keputusan pengguna 20/11/2026 21:06 WIB):
// client (mitra kerjasama RRI), operator (petugas bidang Layanan &
// Pengembangan Usaha — kerja operasional harian), dan admin (super
// user yang mengelola web app). Peran dibedakan lewat field `peran`
// di dokumen `users/{uid}`. Keputusan ini menggantikan model EMPAT
// PERAN PR #124 (tidak jadi di-merge 20/11/2026): dua peran
// tambahan model empat peran DIHAPUS dan checklist verifikasi
// DIHAPUS — tidak ada koleksi checklist di aturan ini. 'operator'
// kembali berarti staf LPU (seperti PR #121); 'admin' mengambil
// alih kuasa penuh operator model empat peran. Akun
// lpu.lpprripalembang@gmail.com akan menjadi 'admin' SETELAH merge +
// publish rules (saat ini masih 'operator' di Firestore — aturan
// ini tetap memberi operator akses baca/tulis operasional penuh,
// jadi login tidak putus sebelum profil dibalik).
// Client hanya membaca data yang `klienId`-nya sama dengan klienId di
// profilnya (blok "Akses baca klien" di bawah) — routing client-side
// saja BUKAN keamanan. SIGNUP PUBLIK (keputusan pengguna 19/11/2026
// 16:12 WIB): calon klien membuat akun sendiri dari halaman login —
// signup SELALU menghasilkan peran 'client' (tanpa klienId; admin
// menautkan setelah verifikasi), tidak ada jalan membuat akun
// operator/admin lewat signup. Akun internal dibuat admin dari
// dalam aplikasi (secondary FirebaseApp, lihat src/lib/auth.ts
// `buatAkunInternal`) atau kartu invite di Master & Users. Akun
// client tanpa klienId TIDAK BISA membaca data klien mana pun
// (aturan baca menuntut klienId yang cocok) dan TIDAK BISA
// menaikkan perannya (update menuntut peran/klienId tak berubah);
// satu-satunya yang bisa dilakukan akun belum tertaut adalah membuat
// submission Ajukan dengan klienId '' yang dibuatOleh-nya sama dengan
// email akun Auth-nya (lihat blok pengajuanKlien). Akses publik (Lacak
// + pengajuan publik + booking meeting) diatur di blok publik
// tersendiri di bawah.
// Semua akses wajib terautentikasi, KECUALI tiga jalur publik di blok
// publik tersendiri di bawah (Lacak + pengajuan publik + booking
// meeting) — ketiganya dibatasi ketat: create publik tervalidasi dan
// append-only, get publik hanya per-dokumen (list dilarang). Data
// Keuangan (penerimaanAcuan) hanya dibaca, tidak pernah ditulis dari
// aplikasi.
// CARA AKTIFKAN: tempel seluruh isi file ini di Firebase console →
// Firestore Database → Rules → Publish. File ini saja BELUM mengaktifkan
// aturan apa pun di proyek pengguna.
// PERINGATAN: file ini BERUBAH di PR ini (tiga peran) — publikasikan
// rules ini di console SEBELUM merge PR: bila merge dulu, pembuatan
// akun Admin ditolak (aturan lama hanya mengenal peran
// operator/client) dan akun admin tidak bisa membaca data
// operasional.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pembantu ----------

    // Sudah login (akun Auth apa pun yang dibuat admin di console).
    function sudahLogin() {
      return request.auth != null;
    }

    // Dokumen profil pemanggil di koleksi users.
    function profilPemanggil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Pemanggil adalah Operator (petugas bidang Layanan &
    // Pengembangan Usaha — kerja operasional harian).
    function adalahOperator() {
      return sudahLogin() && profilPemanggil().peran == 'operator';
    }

    // Pemanggil adalah Admin (super user yang mengelola web app —
    // membuat akun dan akses peran lain, migrasi, master data,
    // konfigurasi, audit, kunci laporan).
    function adalahAdmin() {
      return sudahLogin() && profilPemanggil().peran == 'admin';
    }

    // Pemanggil adalah salah satu peran internal (admin portal) —
    // operator atau admin. Dipakai untuk BACA data operasional:
    // keduanya melihat data yang sama.
    function adalahStafInternal() {
      return adalahOperator() || adalahAdmin();
    }

    // Pemanggil boleh MENULIS data operasional (operator + admin).
    function bolehTulisOperasional() {
      return adalahOperator() || adalahAdmin();
    }

    // Pemanggil adalah Client (tiga peran, 20/11/2026).
    function adalahClient() {
      return sudahLogin() && profilPemanggil().peran == 'client';
    }

    // Id record klien yang ditautkan ke akun client pemanggil
    // (users/{uid}.klienId). Akun client tanpa klienId tidak bisa
    // membaca apa pun — lihat peranDariProfil di src/lib/auth.ts.
    function klienPemanggil() {
      return profilPemanggil().klienId;
    }

    // Kode satker pemanggil, dari dokumen users/{uid}-nya.
    function satkerPemanggil() {
      return profilPemanggil().satker.kode;
    }

    // Data (lama atau baru) milik satker pemanggil.
    function satkerMilikPemanggil(data) {
      return data.satker.kode == satkerPemanggil();
    }

    // ---------- Koleksi data bersatker (22 koleksi di blok ini) ----------
    // Baca: staf internal (operator + admin) dari satker yang sama.
    // Tulis: operator + admin. Saat membuat data
    // baru, satker dicek dari data yang dikirim; saat mengubah, dicek dari
    // data lama DAN data baru (tidak boleh pindah satker). Tiket &
    // umpanBalik (Fase C) memakai aturan yang sama di blok tersendiri di
    // bawah, jadi total koleksi bersatker menjadi 23. Chat antar
    // internal (Fase C, PR #45) memakai aturan yang sama di blok
    // tersendiri juga, jadi total koleksi bersatker menjadi 24.
    match /{koleksi}/{id} {
      allow read: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task',
          // Panel Order — enam tabel (PR #115): lima koleksi baru, mulai
          // kosong. Webhook Tally menulis adsQuotationRequest lewat Admin
          // SDK (bypass rules); aturan di sini untuk baca operator.
          'adsQuotationRequest', 'venueBookOrder', 'spaceRentOrder',
          'trainingOrder', 'partnershipRequest',
          // Impor MoU 19/11/2026: koleksi `mou` (44 record dari file
          // pengguna); ditulis lewat migrasi MoU (Admin SDK tidak
          // dipakai — client SDK operator, seperti migrasi lain).
          'mou',
          // Impor Commitment 19/11/2026: koleksi `commitment` (4 record
          // dari file pengguna); ditulis lewat migrasi Commitment
          // (Admin SDK tidak dipakai — client SDK operator, seperti
          // migrasi lain).
          'commitment',
          // Approvement (definisi pengguna 24/11/2026): koleksi
          // `approvement` (4 record DUMMY dari seed); ditulis lewat
          // migrasi Approvement (langkah terpisah setelah PR merge).
          'approvement'
        ]
        && bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data);
      allow create: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task',
          'adsQuotationRequest', 'venueBookOrder', 'spaceRentOrder',
          'trainingOrder', 'partnershipRequest',
          // Impor MoU 19/11/2026: koleksi `mou` (44 record dari file
          // pengguna); ditulis lewat migrasi MoU (Admin SDK tidak
          // dipakai — client SDK operator, seperti migrasi lain).
          'mou',
          // Impor Commitment 19/11/2026: koleksi `commitment` (4 record
          // dari file pengguna); ditulis lewat migrasi Commitment
          // (Admin SDK tidak dipakai — client SDK operator, seperti
          // migrasi lain).
          'commitment',
          // Approvement (definisi pengguna 24/11/2026): koleksi
          // `approvement` (4 record DUMMY dari seed); ditulis lewat
          // migrasi Approvement (langkah terpisah setelah PR merge).
          'approvement'
        ]
        && bolehTulisOperasional()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task',
          'adsQuotationRequest', 'venueBookOrder', 'spaceRentOrder',
          'trainingOrder', 'partnershipRequest',
          // Impor MoU 19/11/2026: koleksi `mou` (44 record dari file
          // pengguna); ditulis lewat migrasi MoU (Admin SDK tidak
          // dipakai — client SDK operator, seperti migrasi lain).
          'mou',
          // Impor Commitment 19/11/2026: koleksi `commitment` (4 record
          // dari file pengguna); ditulis lewat migrasi Commitment
          // (Admin SDK tidak dipakai — client SDK operator, seperti
          // migrasi lain).
          'commitment',
          // Approvement (definisi pengguna 24/11/2026): koleksi
          // `approvement` (4 record DUMMY dari seed); ditulis lewat
          // migrasi Approvement (langkah terpisah setelah PR merge).
          'approvement'
        ]
        && bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if koleksi in [
          'klien', 'kontrak', 'tagihan', 'pembayaran', 'denda',
          'sewa', 'pengajuan', 'prospect', 'quotation', 'order', 'meeting',
          'event', 'advertisement', 'task',
          'adsQuotationRequest', 'venueBookOrder', 'spaceRentOrder',
          'trainingOrder', 'partnershipRequest',
          // Impor MoU 19/11/2026: koleksi `mou` (44 record dari file
          // pengguna); ditulis lewat migrasi MoU (Admin SDK tidak
          // dipakai — client SDK operator, seperti migrasi lain).
          'mou',
          // Impor Commitment 19/11/2026: koleksi `commitment` (4 record
          // dari file pengguna); ditulis lewat migrasi Commitment
          // (Admin SDK tidak dipakai — client SDK operator, seperti
          // migrasi lain).
          'commitment',
          // Approvement (definisi pengguna 24/11/2026): koleksi
          // `approvement` (4 record DUMMY dari seed); ditulis lewat
          // migrasi Approvement (langkah terpisah setelah PR merge).
          'approvement'
        ]
        && bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data);
    }

    // ---------- Akses baca klien (tiga peran, 20/11/2026) ----------
    // Client hanya membaca data yang klienId-nya sama dengan klienId di
    // profilnya (users/{uid}.klienId) DAN satker yang sama. TIDAK ADA
    // create/update/delete klien, dan TIDAK ADA list lintas klien:
    // - Koleksi bersatker (kontrak, tagihan, pembayaran, denda, mou,
    //   commitment): `allow read` mencakup get + list, TAPI query list
    //   WAJIB memfilter klienId + satker.kode (lihat muatDataKlien di
    //   src/lib/firestoreStore.ts) — query tanpa kedua filter itu
    //   DITOLAK rules, karena aturan tidak bisa membuktikan semua
    //   dokumen hasil query milik client ini. Indeks komposit
    //   (klienId + satker.kode) wajib dibuat di console per koleksi.
    // - `klien`: hanya get per id (record sendiri); list DILARANG.
    // - `dokumen`: tidak punya field satker — hanya dicek klienId.
    //   Field klienId di dokumen diisi backfill satu kali
    //   (src/lib/backfillKlienId.ts); dokumen lama tanpa klienId
    //   tidak terbaca client.
    // - `pengajuanKlien`: milik client lewat klienId ATAU lewat email
    //   pembuat (submission publik sebelum punya akun).
    // Aturan Firestore bersifat OR antar blok match yang sama — blok
    // generik staf internal di atas tetap mengatur akses Operator dan
    // Admin; blok ini
    // HANYA menambah jalur baca client. Client yang menebak id
    // dokumen klien lain tetap DITOLAK (klienId tidak cocok).
    match /klien/{id} {
      allow get: if adalahClient()
        && resource.data.id == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
      allow list: if false;
    }
    match /kontrak/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /tagihan/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /pembayaran/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /denda/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /mou/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /commitment/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(resource.data);
    }
    match /dokumen/{id} {
      allow read: if adalahClient()
        && resource.data.klienId == klienPemanggil();
    }
    match /pengajuanKlien/{id} {
      allow read: if adalahClient()
        && (resource.data.klienId == klienPemanggil()
          || resource.data.dibuatOleh == request.auth.token.email)
        && satkerMilikPemanggil(resource.data);
    }

    // ---------- Data acuan Keuangan: READ-ONLY ----------
    // Setelah migrasi, tidak ada satu pun peran aplikasi yang boleh
    // create/update/delete — data ini milik Keuangan; aplikasi hanya
    // menampilkan dan merekonsiliasi. Satu-satunya pengecualian adalah
    // migrasi satu kali (src/lib/migrasi.ts): sebelum dokumen
    // `meta/migrasi` ada, Admin boleh create (menulis 62 baris acuan
    // awal). Begitu penanda migrasi ada, create ikut tertutup.
    match /penerimaanAcuan/{id} {
      allow read: if adalahStafInternal()
        && satkerMilikPemanggil(resource.data);
      allow create: if bolehTulisOperasional()
        && !exists(/databases/$(database)/documents/meta/migrasi)
        && satkerMilikPemanggil(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- Dokumen: tanpa field satker ----------
    // Koleksi dokumen tidak menyimpan field satker (tautan ke kontrak),
    // jadi hanya dicek peran internal (operator + admin).
    match /dokumen/{id} {
      allow read: if adalahStafInternal();
      allow create, update, delete: if bolehTulisOperasional();
    }

    // ---------- Help-Desk & Feedback: bersatker (Fase C) ----------
    // Tiket konsultasi dan umpan balik survei milik satker pemanggil —
    // aturan sama seperti koleksi bersatker lain (dibuat di blok umum di
    // atas, tapi ditulis terpisah di sini agar mudah dibaca per modul).
    // Tiket ditujukan ke Direktorat Layanan & Pengembangan Usaha (Q-12);
    // PIC per kategori belum ditentukan, jadi tidak ada aturan per PIC.
    match /tiket/{id} {
      allow read: if adalahStafInternal() && satkerMilikPemanggil(resource.data);
      allow create: if bolehTulisOperasional()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if bolehTulisOperasional() && satkerMilikPemanggil(resource.data);
    }
    match /umpanBalik/{id} {
      allow read: if adalahStafInternal() && satkerMilikPemanggil(resource.data);
      allow create: if bolehTulisOperasional()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if bolehTulisOperasional() && satkerMilikPemanggil(resource.data);
    }

    // ---------- Chat antar operator 1-to-1: bersatker (Fase C, PR #45) ----------
    // Pesan chat milik satker pemanggil — aturan sama seperti koleksi
    // bersatker lain (dibuat di blok umum di atas, tapi ditulis terpisah
    // di sini agar mudah dibaca per modul). Pesan TIDAK menulis audit;
    // aturan ini hanya mengatur koleksi `pesan` itu sendiri.
    // PERHATIAN: file ini saja BELUM mengaktifkan aturan apa pun —
    // tempel ulang seluruh isi file ini di Firebase console ->
    // Firestore Database -> Rules -> Publish (lihat catatan di atas).
    match /pesan/{id} {
      allow read: if adalahStafInternal() && satkerMilikPemanggil(resource.data);
      allow create: if bolehTulisOperasional()
        && satkerMilikPemanggil(request.resource.data);
      allow update: if bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if bolehTulisOperasional() && satkerMilikPemanggil(resource.data);
    }

    // ---------- Knowledge Base: nasional, tanpa field satker (Fase C) ----------
    // Artikel Regulasi & SOP dibaca staf internal mana pun (nasional, seperti
    // dokumen) dan ditulis operator/admin. Tidak ada filter satker karena entitas
    // artikelKB memang tidak menyimpan field satker.
    match /artikelKB/{id} {
      allow read: if adalahStafInternal();
      allow create, update, delete: if bolehTulisOperasional();
    }

    // ---------- FAQ Resources: nasional, tanpa field satker (PR #49) ----------
    // Sama seperti artikelKB: dibaca staf internal mana pun, ditulis operator/admin.
    match /faq/{id} {
      allow read: if adalahStafInternal();
      allow create, update, delete: if bolehTulisOperasional();
    }

    // ---------- Audit: hanya tambah (append-only) ----------
    // Entri audit tidak boleh diubah atau dihapus setelah ditulis.
    match /audit/{id} {
      allow read: if adalahAdmin();
      allow create: if bolehTulisOperasional();
      allow update, delete: if false;
    }

    // ---------- Penanda migrasi: hanya boleh dibuat sekali ----------
    // Migrasi satu kali (src/lib/migrasi.ts) membuat dokumen ini; bila
    // sudah ada, create ditolak.
    match /meta/migrasi {
      allow read: if adalahStafInternal();
      allow create: if adalahAdmin()
        && !exists(/databases/$(database)/documents/meta/migrasi);
      allow update, delete: if false;
    }

    // ---------- Penanda re-migrasi kontrak 2026: hanya boleh dibuat sekali ----------
    // Re-migrasi data kontrak (src/lib/remigrasi.ts, PR #53) mengganti
    // 5 koleksi (klien, kontrak, tagihan, pembayaran, denda) dengan seed
    // pasca-PR #52. Penanda ini dibuat sekali; bila sudah ada, create
    // ditolak. Terpisah dari `meta/migrasi` — migrasi pertama tetap
    // tidak bisa jalan dua kali.
    match /meta/migrasi-kontrak-2026 {
      allow read: if adalahStafInternal();
      allow create: if adalahAdmin()
        && !exists(/databases/$(database)/documents/meta/migrasi-kontrak-2026);
      allow update, delete: if false;
    }

    // ---------- Penanda migrasi MoU: hanya boleh dibuat sekali ----------
    // Migrasi MoU (src/lib/migrasiMou.ts, impor MoU 19/11/2026) menulis
    // 44 record ke koleksi `mou` dari seed (src/lib/seedMou.ts).
    // Penanda ini dibuat sekali; bila sudah ada, create ditolak.
    // Terpisah dari `meta/migrasi` dan `meta/migrasi-kontrak-2026`.
    match /meta/migrasi-mou-2026 {
      allow read: if adalahStafInternal();
      allow create: if adalahAdmin()
        && !exists(/databases/$(database)/documents/meta/migrasi-mou-2026);
      allow update, delete: if false;
    }

    // ---------- Penanda migrasi Commitment: hanya boleh dibuat sekali ----------
    // Migrasi Commitment (src/lib/migrasiCommitment.ts, impor Commitment
    // 19/11/2026) menulis 4 record ke koleksi `commitment` dari seed
    // (src/lib/seedCommitment.ts). Penanda ini dibuat sekali; bila sudah
    // ada, create ditolak. Terpisah dari `meta/migrasi`,
    // `meta/migrasi-kontrak-2026`, dan `meta/migrasi-mou-2026`.
    match /meta/migrasi-commitment-2026 {
      allow read: if adalahStafInternal();
      allow create: if adalahAdmin()
        && !exists(/databases/$(database)/documents/meta/migrasi-commitment-2026);
      allow update, delete: if false;
    }

    // ---------- Penanda backfill klienId: hanya boleh dibuat sekali ----------
    // Backfill klienId (src/lib/backfillKlienId.ts, dua peran 19/11/2026)
    // menambah field `klienId` ke tagihan/pembayaran/denda/dokumen/MoU
    // live. Penanda ini dibuat sekali; bila sudah ada, create ditolak.
    // Terpisah dari `meta/migrasi`, `meta/migrasi-kontrak-2026`,
    // `meta/migrasi-mou-2026`, dan `meta/migrasi-commitment-2026`.
    match /meta/backfill-klienId-2026 {
      allow read: if adalahStafInternal();
      allow create: if adalahAdmin()
        && !exists(/databases/$(database)/documents/meta/backfill-klienId-2026);
      allow update, delete: if false;
    }

    // ---------- Profil pengguna (koleksi users) ----------
    // Pengguna hanya boleh membaca dokumennya sendiri. Tiga peran
    // (20/11/2026) + SIGNUP PUBLIK (19/11/2026 16:12 WIB):
    // - Self-create OPERATOR (login pertama dari profil userProfiles
    //   yang disiapkan): HANYA bila ada dokumen userProfiles untuk
    //   email yang ditulis (exists(...) di bawah). Sebelum perubahan
    //   ini aturan mengizinkan pengguna mana pun membuat profil
    //   operator untuk dirinya sendiri — dengan signup publik itu
    //   menjadi jalan penaikan peran (role escalation) yang sepele,
    //   jadi sekarang dikunci ke profil yang sudah disiapkan admin.
    // - Self-create CLIENT (signup publik di halaman login): peran
    //   'client', TANPA klienId, email HARUS sama dengan email akun
    //   Auth-nya. Signup selalu menghasilkan client (lihat
    //   daftarDenganEmail di src/lib/auth.ts); tidak ada jalan
    //   membuat akun operator lewat signup.
    // - Admin boleh membuat profil akun lain (invite + buat akun
    //   internal): peran 'operator' atau 'admin' (tanpa klienId)
    //   atau 'client' (klienId WAJIB non-kosong — menautkan akun ke
    //   record klien).
    // - Admin boleh MENAUTKAN akun client hasil signup publik
    //   (profil sudah ada sebagai client TANPA klienId): HANYA
    //   menambah klienId (lihat klausa update operator di bawah).
    // Peran, satker, dan klienId TIDAK boleh diubah setelah dibuat —
    // perubahan peran dilakukan admin langsung di console. Khususnya:
    // client TIDAK BISA menaikkan perannya sendiri (update menuntut
    // peran baru == peran lama) dan TIDAK BISA menautkan dirinya ke
    // klien mana pun (update menuntut klienId baru == klienId lama).
    match /users/{uid} {
      allow get: if sudahLogin() && request.auth.uid == uid;
      allow create: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.peran == 'operator'
        && request.resource.data.email is string
        && request.resource.data.satker.kode is string
        && exists(/databases/$(database)/documents/userProfiles/$(request.resource.data.email));
      allow create: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.peran == 'client'
        && !('klienId' in request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.satker.kode is string;
      allow create: if adalahAdmin()
        && request.resource.data.peran in ['operator', 'admin', 'client']
        && request.resource.data.email is string
        && request.resource.data.satker.kode is string
        && (request.resource.data.peran in ['operator', 'admin']
          || (request.resource.data.klienId is string
            && request.resource.data.klienId.size() > 0));
      allow update: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.peran == resource.data.peran
        && request.resource.data.satker == resource.data.satker
        && request.resource.data.get('klienId', '') == resource.data.get('klienId', '');
      // Admin menautkan akun client hasil signup publik (profil
      // sudah ada sebagai client TANPA klienId): HANYA menambah
      // klienId — peran harus tetap 'client', satker tetap, klienId
      // lama harus kosong (akun yang sudah tertaut TIDAK bisa
      // ditautkan ulang dari sini). Dipakai kartu "Invite Client
      // Account" saat UID yang dimasukkan adalah akun hasil signup.
      allow update: if adalahAdmin()
        && resource.data.peran == 'client'
        && request.resource.data.peran == 'client'
        && request.resource.data.satker == resource.data.satker
        && resource.data.get('klienId', '') == ''
        && request.resource.data.klienId is string
        && request.resource.data.klienId.size() > 0;
      allow delete: if false;
    }

    // ---------- Profil pengguna (koleksi userProfiles, dipakai migrasi) ----------
    // Pengguna hanya boleh membaca dokumennya sendiri (dicocokkan lewat
    // email akun Auth). Hanya Admin boleh menulis — dipakai untuk
    // bootstrap profil saat migrasi satu kali.
    match /userProfiles/{email} {
      allow get: if sudahLogin() && request.auth.token.email == email;
      allow create, update, delete: if adalahAdmin();
    }

    // ---------- Pengajuan publik — antrean approval (Operator + Admin) ----------
    // KOREKSI 2026-11-15 yang lama ("peran klien dihapus") DIBALIK
    // keputusan 19/11/2026: submission publik (pengajuanKlien) tetap
    // dibaca/diproses Operator dan Admin dari satkernya, DAN client yang login
    // boleh membuat submission yang tertaut ke akunnya (klienId milik
    // sendiri) serta membaca submission miliknya. Aturan Firestore
    // bersifat OR antar blok match yang sama.

    // Submission publik (form Ajukan Permohonan, tanpa login).
    match /pengajuanKlien/{id} {
      // Staf internal: baca penuh satkernya (dipakai muatDariFirestore).
      allow read: if adalahStafInternal()
        && satkerMilikPemanggil(resource.data);
      // Staf internal boleh membuat (tidak dipakai aplikasi saat ini).
      allow create: if bolehTulisOperasional()
        && satkerMilikPemanggil(request.resource.data);
      // Client yang login (tiga peran 20/11/2026): HANYA create
      // submission yang klienId-nya sama dengan klienId di profilnya
      // (dipakai form Ajukan di dalam Client Portal — submission
      // tertaut ke akun client dan tampil di "My Requests"). Validasi
      // field sama dengan jalur publik; klienId TIDAK BOLEH '' di sini
      // (jalur publik memakai klienId '' — lihat di bawah).
      allow create: if adalahClient()
        && request.resource.data.klienId == klienPemanggil()
        && satkerMilikPemanggil(request.resource.data)
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.jenis in [
          'Pengajuan Kerja Sama', 'Media Order', 'Permohonan Sewa'
        ]
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() > 0
        && request.resource.data.namaPic is string
        && request.resource.data.namaPic.size() > 0
        && request.resource.data.namaInstitusi is string
        && request.resource.data.namaInstitusi.size() > 0
        && request.resource.data.dibuatOleh is string
        && request.resource.data.dibuatOleh.size() > 0
        && request.resource.data.tanggalBuat is string
        && request.resource.data.tanggalBuat.size() > 0
        && (!('nilaiPerkiraan' in request.resource.data)
          || request.resource.data.nilaiPerkiraan is number)
        && (!('telepon' in request.resource.data)
          || request.resource.data.telepon is string);
      // Client yang login TAPI BELUM TERTAUT (akun baru dari signup
      // publik, 19/11/2026 16:12 WIB): boleh membuat submission
      // jalur publik (klienId '') — inilah jalur Ajukan yang
      // diarahkan portal 'belum tertaut' ke calon klien. DibuatOleh
      // HARUS sama dengan email akun Auth-nya (mengikat submission
      // ke pendaftar; operator melihat siapa pengirimnya saat
      // menautkan). Validasi field sama dengan jalur publik. Tanpa
      // klausa ini, submission akun belum tertaut ditolak: jalur
      // publik menuntut request.auth == null, jalur client menuntut
      // klienId yang cocok.
      allow create: if sudahLogin()
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.klienId == ''
        && request.resource.data.dibuatOleh == request.auth.token.email
        && request.resource.data.jenis in [
          'Pengajuan Kerja Sama', 'Media Order', 'Permohonan Sewa'
        ]
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() > 0
        && request.resource.data.namaPic is string
        && request.resource.data.namaPic.size() > 0
        && request.resource.data.namaInstitusi is string
        && request.resource.data.namaInstitusi.size() > 0
        && request.resource.data.dibuatOleh is string
        && request.resource.data.dibuatOleh.size() > 0
        && request.resource.data.tanggalBuat is string
        && request.resource.data.tanggalBuat.size() > 0
        && request.resource.data.satker.kode is string
        && (!('nilaiPerkiraan' in request.resource.data)
          || request.resource.data.nilaiPerkiraan is number)
        && (!('telepon' in request.resource.data)
          || request.resource.data.telepon is string);
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form Ajukan Permohonan (src/modules/Ajukan.tsx lewat
      // kirimPengajuanPublik di firestoreStore.ts). TIDAK ada read /
      // update / delete publik — antrean hanya dibaca dan diproses
      // Operator dan Admin. Validasi: field wajib terisi, jenis dari daftar yang
      // dikenal, status SELALU 'Menunggu', klienId SELALU '' (calon klien
      // belum tercatat; diisi Operator saat approval).
      allow create: if request.auth == null
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.klienId == ''
        && request.resource.data.jenis in [
          'Pengajuan Kerja Sama', 'Media Order', 'Permohonan Sewa'
        ]
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() > 0
        && request.resource.data.namaPic is string
        && request.resource.data.namaPic.size() > 0
        && request.resource.data.namaInstitusi is string
        && request.resource.data.namaInstitusi.size() > 0
        && request.resource.data.dibuatOleh is string
        && request.resource.data.dibuatOleh.size() > 0
        && request.resource.data.tanggalBuat is string
        && request.resource.data.tanggalBuat.size() > 0
        && request.resource.data.satker.kode is string
        && (!('nilaiPerkiraan' in request.resource.data)
          || request.resource.data.nilaiPerkiraan is number)
        && (!('telepon' in request.resource.data)
          || request.resource.data.telepon is string);
      // Hanya Operator dan Admin yang mengubah (approval): satker tidak boleh pindah.
      allow update: if bolehTulisOperasional()
        && satkerMilikPemanggil(resource.data)
        && satkerMilikPemanggil(request.resource.data);
      allow delete: if false;
    }

    // ---------- Permintaan free call publik → koleksi meeting ----------
    // (PR landing-booking-ke-meeting, 2026-11-17): form booking publik di
    // landing menyimpan permintaan sebagai dokumen Meeting agar muncul di
    // tabel Meeting panel admin. Aturan Firestore bersifat OR antar blok
    // match yang sama — blok generik di atas tetap mengatur baca/tulis
    // Operator untuk 'meeting'; blok ini HANYA menambah jalur create
    // publik. TIDAK ada read / update / delete publik.
    // Validasi: tanggal 'yyyy-mm-dd', jam 'HH:mm' (WIB), agenda +
    // contactPersonNama + contactPersonTelepon + contactPersonEmail wajib
    // terisi (email format dasar: ada '@' dan titik setelahnya),
    // clientRepresentatives tepat 1 nama, rriRepresentatives list (boleh
    // kosong — Operator melengkapi via Update), satker SELALU '41'
    // (PALEMBANG, pilot), googleEventId/googleSyncedAt TIDAK boleh ada
    // (belum tersinkron), prospectId/klienId/hasil TIDAK boleh ada.
    // PERINGATAN: blok ini BELUM TERVALIDASI COMPILER — ditulis dari
    // dokumentasi aturan Firestore dan belum diuji di Rules Playground /
    // emulator. Tempel di console, periksa tidak ada error, baru Publish.
    match /meeting/{id} {
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form booking landing (kirimBookingPublik di App.tsx lewat
      // kirimBookingPublik di firestoreStore.ts).
      allow create: if request.auth == null
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.jam is string
        && request.resource.data.jam.matches('^\\d{2}:\\d{2}$')
        && request.resource.data.agenda is string
        && request.resource.data.agenda.size() > 0
        && request.resource.data.contactPersonNama is string
        && request.resource.data.contactPersonNama.size() > 0
        && request.resource.data.contactPersonTelepon is string
        && request.resource.data.contactPersonTelepon.size() > 0
        && request.resource.data.contactPersonEmail is string
        && request.resource.data.contactPersonEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.clientRepresentatives is list
        && request.resource.data.clientRepresentatives.size() == 1
        && request.resource.data.rriRepresentatives is list
        && request.resource.data.peserta is string
        && request.resource.data.peserta.size() > 0
        && request.resource.data.satker.kode == '41'
        && !('googleEventId' in request.resource.data)
        && !('googleSyncedAt' in request.resource.data)
        && !('prospectId' in request.resource.data)
        && !('klienId' in request.resource.data)
        && !('hasil' in request.resource.data)
        && (!('alamatKlien' in request.resource.data)
          || request.resource.data.alamatKlien is string);
    }

    // ---------- Akses publik halaman layanan tambahan (2026-11-21) ----------
    // Form publik Book a Venue / Rent a Space / Get a Journalism Training
    // menulis ke venueBookOrder / spaceRentOrder / trainingOrder (id
    // 'VBR-…'/'SRR-…'/'TRN-…'; kirimPermintaan*Publik di App.tsx lewat
    // kirimPermintaan*Publik di firestoreStore.ts). Aturan Firestore
    // bersifat OR antar blok match yang sama — blok generik di atas tetap
    // mengatur baca/tulis Operator untuk ketiga koleksi; blok-blok ini
    // HANYA menambah jalur create publik. TIDAK ada read / update /
    // delete publik.
    // Validasi (pola blok /meeting): status SELALU 'Baru', satker SELALU
    // '41' (PALEMBANG, pilot), tanggal 'yyyy-mm-dd', email format dasar
    // (ada '@' dan titik setelahnya). Field detail (layanan,
    // tanggalLayanan, keperluan, kontak, email) mengikuti yang ditulis
    // aplikasi — keperluan (pesan inquiry Space) opsional: boleh tidak
    // ada, bila ada harus string.
    // PERINGATAN: blok-blok ini BELUM TERVALIDASI COMPILER — ditulis dari
    // dokumentasi aturan Firestore dan belum diuji di Rules Playground /
    // emulator. Tempel di console, periksa tidak ada error, baru Publish.
    match /venueBookOrder/{id} {
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form booking halaman Book a Venue.
      allow create: if request.auth == null
        && request.resource.data.namaKlien is string
        && request.resource.data.namaKlien.size() > 0
        && request.resource.data.tanggalPermintaan is string
        && request.resource.data.tanggalPermintaan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'Baru'
        && request.resource.data.satker.kode == '41'
        && request.resource.data.layanan is string
        && request.resource.data.layanan.size() > 0
        && request.resource.data.tanggalLayanan is string
        && request.resource.data.tanggalLayanan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keperluan is string
        && request.resource.data.keperluan.size() > 0
        && request.resource.data.kontak is string
        && request.resource.data.kontak.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    match /spaceRentOrder/{id} {
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form inquiry halaman Rent a Space.
      allow create: if request.auth == null
        && request.resource.data.namaKlien is string
        && request.resource.data.namaKlien.size() > 0
        && request.resource.data.tanggalPermintaan is string
        && request.resource.data.tanggalPermintaan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'Baru'
        && request.resource.data.satker.kode == '41'
        && request.resource.data.layanan is string
        && request.resource.data.layanan.size() > 0
        && request.resource.data.kontak is string
        && request.resource.data.kontak.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && (!('keperluan' in request.resource.data)
          || request.resource.data.keperluan is string);
    }
    match /trainingOrder/{id} {
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form registrasi halaman Get a Journalism Training.
      allow create: if request.auth == null
        && request.resource.data.namaKlien is string
        && request.resource.data.namaKlien.size() > 0
        && request.resource.data.tanggalPermintaan is string
        && request.resource.data.tanggalPermintaan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'Baru'
        && request.resource.data.satker.kode == '41'
        && request.resource.data.layanan is string
        && request.resource.data.layanan.size() > 0
        && request.resource.data.tanggalLayanan is string
        && request.resource.data.tanggalLayanan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.kontak is string
        && request.resource.data.kontak.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    match /partnershipRequest/{id} {
      // Publik (tanpa login): HANYA create, append-only, tervalidasi.
      // Dipakai form Partnership Request halaman "Partner with RRI"
      // (2026-11-21; koleksi diganti nama dari mediaPartnerOrder).
      // Pola sama dengan blok spaceRentOrder di atas — TANPA kontak
      // telepon (form tidak meminta nomor telepon) dan TANPA
      // tanggalLayanan (bukan booking berjadwal); institusi dan pesan
      // wajib diisi form. PENTING: terbitkan rules ini di console
      // SEBELUM merge PR halaman Partner with RRI (aturan
      // publish-before-merge) — bila belum terbit, submit publik
      // ditolak dan muatDariFirestore gagal total (satu koleksi
      // tidak diizinkan menggagalkan seluruh load).
      allow create: if request.auth == null
        && request.resource.data.namaKlien is string
        && request.resource.data.namaKlien.size() > 0
        && request.resource.data.institusi is string
        && request.resource.data.institusi.size() > 0
        && request.resource.data.tanggalPermintaan is string
        && request.resource.data.tanggalPermintaan.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.status == 'Baru'
        && request.resource.data.satker.kode == '41'
        && request.resource.data.layanan is string
        && request.resource.data.layanan.size() > 0
        && request.resource.data.keperluan is string
        && request.resource.data.keperluan.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // ---------- Akses publik Lacak — get-by-ID saja, TANPA list ----------
    // KOREKSI 2026-11-15: klien mengakses dokumen kerja samanya dengan
    // memasukkan nomor PKS / nomor tagihan (keputusan 11:22 WIB).
    // Desain anti-enumerasi: publik HANYA boleh `get` satu dokumen
    // kontrak bila tahu ID-nya. ID dokumen kontrak = nomorPks yang
    // di-encode (firestoreStore.ts: kodeIdDokumen memakai
    // encodeURIComponent untuk ID yang mengandung '/'). `list`
    // DILARANG — tidak ada yang bisa mendaftar atau menghitung semua
    // kontrak dari jalur ini.
    // Keterbatasan yang disadari: get-by-ID hanya mendukung lookup lewat
    // nomor PKS. Lookup lewat nomor TAGIHAN + daftar terkait (tagihan,
    // dokumen, pembayaran per kontrak) TIDAK bisa diambil aman hanya
    // dengan rules — query/list tidak bisa dibatasi ke satu kontrak oleh
    // rules. Untuk itu ada Cloud Function `lacakKerjaSama`
    // (functions/index.js) yang memeriksa kode server-side (Admin SDK,
    // melewati rules) dan hanya mengembalikan data kontrak itu.
    // Sampai function itu di-deploy dan App.tsx memanggilnya, Lacak
    // mode Firestore memakai data seed (mode contoh) — lihat komentar di
    // src/modules/Lacak.tsx. Lacak mode contoh bekerja penuh dari seed.
    // PERINGATAN: blok ini BELUM TERVALIDASI COMPILER — ditulis dari
    // dokumentasi aturan Firestore dan belum diuji di Rules Playground /
    // emulator. Tempel di console, periksa tidak ada error, baru Publish.
    match /kontrak/{id} {
      allow get: if request.auth == null;
      allow list: if false;
    }
  }
}
